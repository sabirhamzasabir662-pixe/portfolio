# Server Configuration
PORT=5000
NODE_ENV=development

# Email Configuration (Nodemailer)
# Messages from clients will be delivered to sabirhamzasabir662@gmail.com
# For Gmail, generate an App Password from your Google Account:
# Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sabirhamzasabir662@gmail.com
SMTP_PASS=your_gmail_app_password_here
NOTIFICATION_RECEIVER=sabirhamzasabir662@gmail.com

# Database Path (defaults to ./data/portfolio.db)
DATABASE_FILE=./data/portfolio.db

# GitHub Integration
# Replace with your actual GitHub username
GITHUB_USERNAME=sabirhamzasabir662-pixe
# Optional GitHub Personal Access Token (for higher API rate limit: 5,000 requests/hr)
GITHUB_TOKEN=your_optional_github_token_here
